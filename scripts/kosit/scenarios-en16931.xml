<?xml version="1.0" encoding="UTF-8"?>
<!-- KoSIT validator scenarios that apply only XML schema and the CEN EN 16931
     rules (no XRechnung rules), for producing the expected results of the
     EN 16931 regression test. Used by scripts/kosit-reference.sh. -->
<scenarios xmlns="http://www.xoev.de/de/validator/framework/1/scenarios" frameworkVersion="1.0.0">
  <name>E-Invoice Viewer reference: EN 16931 only</name>
  <author>E-Invoice Viewer</author>
  <date>2026-11-17</date>
  <description><p>XML schema and CEN EN 16931 rules for CII, UBL Invoice and UBL CreditNote.</p></description>
  <scenario>
    <name>EN16931 (CII)</name>
    <description><p>CII</p></description>
    <namespace prefix="rsm">urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100</namespace>
    <namespace prefix="rep">http://www.xoev.de/de/validator/varl/1</namespace>
    <match>exists(/rsm:CrossIndustryInvoice)</match>
    <validateWithXmlSchema><resource><name>CII D16B</name><location>resources/cii/16b/xsd/CrossIndustryInvoice_100pD16B.xsd</location></resource></validateWithXmlSchema>
    <validateWithSchematron><resource><name>EN16931 CII</name><location>resources/cen/EN16931-CII-validation.xslt</location></resource></validateWithSchematron>
    <createReport><resource><name>Report</name><location>resources/xrechnung-report.xsl</location></resource></createReport>
    <acceptMatch>/rep:report/rep:assessment[1]/rep:accept[1]</acceptMatch>
  </scenario>
  <scenario>
    <name>EN16931 (UBL Invoice)</name>
    <description><p>UBL Invoice</p></description>
    <namespace prefix="inv">urn:oasis:names:specification:ubl:schema:xsd:Invoice-2</namespace>
    <namespace prefix="rep">http://www.xoev.de/de/validator/varl/1</namespace>
    <match>exists(/inv:Invoice)</match>
    <validateWithXmlSchema><resource><name>UBL Invoice</name><location>resources/ubl/2.1/xsd/maindoc/UBL-Invoice-2.1.xsd</location></resource></validateWithXmlSchema>
    <validateWithSchematron><resource><name>EN16931 UBL</name><location>resources/cen/EN16931-UBL-validation.xslt</location></resource></validateWithSchematron>
    <createReport><resource><name>Report</name><location>resources/xrechnung-report.xsl</location></resource></createReport>
    <acceptMatch>/rep:report/rep:assessment[1]/rep:accept[1]</acceptMatch>
  </scenario>
  <scenario>
    <name>EN16931 (UBL CreditNote)</name>
    <description><p>UBL CreditNote</p></description>
    <namespace prefix="cn">urn:oasis:names:specification:ubl:schema:xsd:CreditNote-2</namespace>
    <namespace prefix="rep">http://www.xoev.de/de/validator/varl/1</namespace>
    <match>exists(/cn:CreditNote)</match>
    <validateWithXmlSchema><resource><name>UBL CreditNote</name><location>resources/ubl/2.1/xsd/maindoc/UBL-CreditNote-2.1.xsd</location></resource></validateWithXmlSchema>
    <validateWithSchematron><resource><name>EN16931 UBL</name><location>resources/cen/EN16931-UBL-validation.xslt</location></resource></validateWithSchematron>
    <createReport><resource><name>Report</name><location>resources/xrechnung-report.xsl</location></resource></createReport>
    <acceptMatch>/rep:report/rep:assessment[1]/rep:accept[1]</acceptMatch>
  </scenario>
  <noScenarioReport><resource><name>Default</name><location>resources/default-report.xsl</location></resource></noScenarioReport>
</scenarios>
